{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "content-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "content-studio",
        "run",
        "dev:full"
      ],
      "port": 5173
