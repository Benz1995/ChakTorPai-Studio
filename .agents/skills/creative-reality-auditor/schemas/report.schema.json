{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreativeRealityAuditorReport",
  "description": "Output schema for Creative Reality Auditor (CRA) quality evaluation report",
  "type": "object",
  "required": [
    "audit_id",
    "timestamp",
    "title",
    "work_type",
    "world_mode",
    "verdict",
    "total_score",
    "has_critical_fail",
    "score_breakdown",
    "issues",
    "revision_plan"
  ],
  "properties": {
    "audit_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "title": { "type": "string" },
    "work_type": { "type": "string" },
    "world_mode": { "type": "string" },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "PASS_WITH_NOTES", "REVISE", "REJECT", "INSUFFICIENT_EVIDENCE"]
    },
    "verdict_reason": { "type": "string" },
    "total_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "passed": { "type": "boolean" },
    "has_critical_fail": { "type": "boolean" },
    "critical_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "issue", "evidence", "location", "confirmed"],
        "properties": {
          "id": { "type": "string" },
          "issue": { "type": "string" },
          "evidence": { "type": "string" },
          "location": { "type": "string" },
          "confirmed": { "type": "boolean" },
          "veto_rule": { "type": "string" }
        }
      }
    },
    "score_breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "score", "max_score", "weight", "weighted_score", "evidence_summary"],
        "properties": {
          "criterion": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 10 },
          "max_score": { "type": "number", "default": 10 },
          "weight": { "type": "number", "minimum": 0, "maximum": 100 },
          "weighted_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "evidence_summary": { "type": "string" }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "judge",
          "category",
          "severity",
          "location",
          "problem",
          "evidence",
          "why_it_matters",
          "suggested_fix"
        ],
        "properties": {
          "id": { "type": "string" },
          "judge": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "type": "string", "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "location": { "type": "string" },
          "problem": { "type": "string" },
          "evidence": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "suggested_fix": { "type": "string" },
          "alternative_fix": { "type": "string" },
          "expected_impact": { "type": "string" },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
        }
      }
    },
    "judge_opinions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "score": { "type": "number" },
          "summary": { "type": "string" },
          "key_findings": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["EVALUATED", "SKIPPED_INSUFFICIENT_EVIDENCE", "NOT_REQUESTED"] }
        }
      }
    },
    "debate_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": { "type": "string" },
          "advocate_challenge": { "type": "string" },
          "judge_defense": { "type": "string" },
          "resolution": { "type": "string" },
          "verdict_impact": { "type": "string" }
        }
      }
    },
    "unverified_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": { "type": "string" },
          "location": { "type": "string" },
          "status": { "type": "string", "enum": ["UNVERIFIED"] },
          "required_verification": { "type": "string" }
        }
      }
    },
    "revision_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "priority", "target_location", "action", "rationale"],
        "properties": {
          "step": { "type": "integer" },
          "priority": { "type": "string", "enum": ["P0_CRITICAL", "P1_HIGH", "P2_MEDIUM", "P3_POLISH"] },
          "target_location": { "type": "string" },
          "action": { "type": "string" },
          "suggested_text": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    },
    "revised_draft": { "type": "string" },
    "human_override": {
      "type": "object",
      "properties": {
        "overridden": { "type": "boolean" },
        "original_verdict": { "type": "string" },
        "new_verdict": { "type": "string" },
        "rationale": { "type": "string" },
        "operator": { "type": "string" }
      }
    }
  }
}
